{
  "name": "Utility Apps Flutter Android",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17"
    },
    "ghcr.io/nordcominc/devcontainer-features/android-sdk:1.2.0": {
      "platform": "36",
      "build_tools": "36.0.0"
    },
    "ghcr.io/awf-project/devcontainer-features/flutter:1": {
      "version": "stable",
      "precacheAndroid": true
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit"
        },
        "dart.previewFlutterUiGuides": true
      }
    }
  }
}
